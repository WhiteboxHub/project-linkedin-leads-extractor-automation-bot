# LinkedIn Credentials
LINKEDIN_EMAIL=your_email@example.com
LINKEDIN_PASSWORD=your_password

# Chrome Profile (Recommended for bypassing login/captchas)
# Path example: C:\Users\YourUser\AppData\Local\Google\Chrome\User Data
CHROME_PROFILE_PATH=
# Profile folder name (e.g. Default, Profile 1, etc.)
CHROME_PROFILE_NAME=Default
# Your Chrome version (only if auto-detection fails, e.g. 133)
CHROME_VERSION=

# Backend Sync Settings (WBL API)
WBL_API_URL=https://api.whitebox-learning.com/api
WBL_API_TOKEN=
WBL_API_EMAIL=your_wbl_email@example.com
WBL_API_PASSWORD=your_wbl_password
JOB_UNIQUE_ID=bot_linkedin_leads_extractor
EMPLOYEE_ID=353
SELECTED_CANDIDATE_ID=0

# Extraction Settings
MAX_PROFILES_TO_CHECK=500
MAX_PAGES_PER_KEYWORD=20
OPEN_TO_WORK_ONLY=True
LOCATION_FILTER=United States

# SMTP Email Settings (Optional for reporting)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM=your_email@gmail.com
EMAIL_TO=recipient1@example.com,recipient2@example.com
